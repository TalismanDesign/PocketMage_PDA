{
  "name": "usb_stream_wrapper",
  "version": "1.5.2",
  "description": "ESP-IoT-Solution USB Stream (UAC host speaker / UVC host) wrapper for PocketMageOS.",
  "keywords": ["usb", "uac", "audio", "host", "pocketmage"],
  "license": "Apache-2.0",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "srcDir": "../esp-iot-solution/components/usb/usb_stream",
    "srcFilter": [
      "-<*>",
      "+<usb_stream.c>",
      "+<descriptor.c>",
      "+<usb_host_helpers.c>"
    ],
    "includeDir": ".",
    "flags": [
      "-I../esp-iot-solution/components/usb/usb_stream/include",
      "-I../esp-iot-solution/components/usb/usb_stream/private_include",
      "-I/Users/neel/.platformio/packages/framework-espidf/components/usb/include",
      "-I/Users/neel/.platformio/packages/framework-espidf/components/usb/private_include",
      "-I/Users/neel/.platformio/packages/framework-arduinoespressif32-libs/esp32s3/include/usb/include",
      "-I/Users/neel/.platformio/packages/framework-arduinoespressif32-libs/esp32s3/include/hal/esp32s3/include",
      "-DCONFIG_CTRL_TRANSFER_DATA_MAX_BYTES=1024",
      "-DCONFIG_USB_STREAM_QUICK_START=0",
      "-DCONFIG_UVC_GET_DEVICE_DESC=1",
      "-DCONFIG_UVC_GET_CONFIG_DESC=1",
      "-DCONFIG_UVC_PRINT_DESC=1",
      "-DCONFIG_UVC_PRINT_DESC_VERBOSE=0",
      "-DCONFIG_USB_PRE_ALLOC_CTRL_TRANSFER_URB=1",
      "-DCONFIG_USB_PROC_TASK_PRIORITY=5",
      "-DCONFIG_USB_PROC_TASK_CORE=1",
      "-DCONFIG_USB_PROC_TASK_STACK_SIZE=3072",
      "-DCONFIG_USB_WAITING_AFTER_CONN_MS=50",
      "-DCONFIG_USB_CTRL_XFER_TIMEOUT_MS=1000",
      "-DCONFIG_USB_ENUM_FAILED_RETRY=1",
      "-DCONFIG_USB_ENUM_FAILED_RETRY_COUNT=10",
      "-DCONFIG_USB_ENUM_FAILED_RETRY_DELAY_MS=200",
      "-DCONFIG_SAMPLE_PROC_TASK_PRIORITY=2",
      "-DCONFIG_SAMPLE_PROC_TASK_CORE=0",
      "-DCONFIG_SAMPLE_PROC_TASK_STACK_SIZE=3072",
      "-DCONFIG_UVC_PRINT_PROBE_RESULT=1",
      "-DCONFIG_UVC_PRINT_PAYLOAD_HEX=0",
      "-DCONFIG_UVC_CHECK_HEADER_EOH=0",
      "-DCONFIG_UVC_CHECK_HEADER_EOF=1",
      "-DCONFIG_UVC_CHECK_BULK_JPEG_HEADER=1",
      "-DCONFIG_UVC_DROP_NO_EOF_FRAME=0",
      "-DCONFIG_UVC_DROP_OVERFLOW_FRAME=1",
      "-DCONFIG_NUM_BULK_STREAM_URBS=2",
      "-DCONFIG_NUM_BULK_BYTES_PER_URB=2048",
      "-DCONFIG_NUM_ISOC_UVC_URBS=3",
      "-DCONFIG_NUM_PACKETS_PER_URB=4",
      "-DCONFIG_NUM_ISOC_SPK_URBS=3",
      "-DCONFIG_NUM_ISOC_MIC_URBS=3",
      "-DCONFIG_UAC_MIC_CB_MIN_MS_DEFAULT=16",
      "-DCONFIG_UAC_SPK_ST_MAX_MS_DEFAULT=16",
      "-DCONFIG_UAC_MIC_PACKET_COMPENSATION=0",
      "-DCONFIG_UAC_SPK_PACKET_COMPENSATION=1",
      "-DCONFIG_UAC_SPK_PACKET_COMPENSATION_CONTINUOUS=1",
      "-DCONFIG_UAC_SPK_PACKET_COMPENSATION_TIMEOUT_MS=80",
      "-DCONFIG_UAC_SPK_PACKET_COMPENSATION_SIZE_MS=10",
      "-DUSB_STREAM_VER_MAJOR=1",
      "-DUSB_STREAM_VER_MINOR=5",
      "-DUSB_STREAM_VER_PATCH=2"
    ]
  }
}
